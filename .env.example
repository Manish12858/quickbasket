# Copy this file to .env (same folder as manage.py) and fill in your own values.
# .env is git-ignored - never commit real secrets.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Gmail SMTP for real verification / password-reset emails.
# Use a Google "App password", not your normal password.
# Leave these empty to print emails to the terminal instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
